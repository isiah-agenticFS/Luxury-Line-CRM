<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ScrubCRM.Admin.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Scrub CRM</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="bg-light">
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" href="~/Admin/Dashboard.aspx" runat="server">Scrub CRM</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Dashboard.aspx" runat="server">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Products.aspx" runat="server">Products</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Inventory.aspx" runat="server">Inventory</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Customers.aspx" runat="server">Customers</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Organizations.aspx" runat="server">Organizations</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Orders.aspx" runat="server">Orders</a></li>
                    </ul>
                    <span class="navbar-text text-light me-3"><asp:Literal ID="litUserName" runat="server" /></span>
                    <asp:LinkButton ID="btnSignOut" runat="server" CssClass="btn btn-outline-light btn-sm" OnClick="btnSignOut_Click">Sign Out</asp:LinkButton>
                </div>
            </div>
        </nav>

        <div class="container-fluid pb-5">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>
    </form>
</body>
</html>
