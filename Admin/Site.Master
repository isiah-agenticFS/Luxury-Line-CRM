<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ScrubCRM.Admin.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Luxury Line CRM</asp:ContentPlaceHolder></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/Content/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" href="~/Admin/Dashboard.aspx" runat="server">
                    <i class="bi bi-heart-pulse-fill brand-icon"></i>Luxury Line CRM
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Dashboard.aspx" runat="server"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Products.aspx" runat="server"><i class="bi bi-box-seam me-1"></i>Products</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Inventory.aspx" runat="server"><i class="bi bi-layers me-1"></i>Inventory</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Customers.aspx" runat="server"><i class="bi bi-people me-1"></i>Customers</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Organizations.aspx" runat="server"><i class="bi bi-building me-1"></i>Organizations</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Admin/Orders.aspx" runat="server"><i class="bi bi-receipt me-1"></i>Orders</a></li>
                    </ul>
                    <span class="navbar-text me-3"><asp:Literal ID="litUserName" runat="server" /></span>
                    <asp:LinkButton ID="btnSignOut" runat="server" CssClass="btn btn-outline-light btn-sm" OnClick="btnSignOut_Click">
                        <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                    </asp:LinkButton>
                </div>
            </div>
        </nav>

        <div class="container-fluid pb-5">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/site.js" runat="server"></script>
</body>
</html>
