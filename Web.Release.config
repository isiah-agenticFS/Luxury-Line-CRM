<?xml version="1.0" encoding="utf-8"?>
<!-- Web.config transform applied when publishing in Release configuration.
     Sets requireSSL="true" so the ASP.NET auth cookie is only sent over HTTPS.
     Azure App Service enforces HTTPS at the load balancer, so the app always
     receives HTTPS requests in production.
     See: https://docs.microsoft.com/aspnet/config-builder -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <system.web>
    <!-- Require the auth cookie to be transmitted over HTTPS only. -->
    <httpCookies requireSSL="true" httpOnlyCookies="true"
                 xdt:Transform="SetAttributes" />
  </system.web>

</configuration>
